# --- Deepgram (speech-to-text) ---
DEEPGRAM_API_KEY=your-deepgram-key

# --- 60db (text-to-speech) ---
SIXTYDB_API_KEY=your-60db-key
# Optional overrides (defaults shown):
# SIXTYDB_WS_URL=wss://api.60db.ai/ws/tts
# SIXTYDB_VOICE_ID=default-voice
# SIXTYDB_AUDIO_ENCODING=LINEAR16
# SIXTYDB_SAMPLE_RATE=24000
# SIXTYDB_SPEED=1.0
# SIXTYDB_STABILITY=50
# SIXTYDB_SIMILARITY=75
